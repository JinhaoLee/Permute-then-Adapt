{
  "coco_root": "data/coco",
  "teacher_model": "openai/clip-vit-base-patch32",
  "student_model": "openai/clip-vit-base-patch16",
  "output_dir": "runs/pta-coco-seed41",
  "seed": 41,
  "epochs": 20,
  "batch_size": 512,
  "eval_batch_size": 1024,
  "eval_steps": 50,
  "early_stopping_patience": 5,
  "learning_rate": 0.0000125,
  "weight_decay": 0.0001,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "precision": "bf16",
  "attention_implementation": "sdpa",
  "gradient_checkpointing": true,
  "vision_tuning": "all_blocks",
  "last_text_blocks": 2,
  "train_logit_scale": true,
  "caption_sampling": "random",
  "alpha": 0.01,
  "calibration_size": 5000,
  "calibration_batch_size": 1000,
  "calibration_rule": "finite_rank",
  "calibration_budget_unit": "retained_scores",
  "calibration_rng": "shared",
  "calibration_device": "cpu",
  "validation_caption_mode": "first",
  "num_workers": 8,
  "drop_last": true,
  "device": "cuda"
}
